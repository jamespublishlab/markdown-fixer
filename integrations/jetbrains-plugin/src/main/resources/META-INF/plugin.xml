<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. Must remain constant for the plugin's lifetime. -->
    <id>com.markdownfixer</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Markdown Fixer</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="support@example.com" url="https://github.com/yourrepo/markdown-fixer">Markdown Fixer Team</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
        <p>Automatically fixes common markdown formatting issues in your files.</p>

        <h3>Features</h3>
        <ul>
            <li>Adds proper blank lines around lists for better readability</li>
            <li>Converts consecutive field-style metadata (**Key:** value) to bulleted lists</li>
            <li>Collapses excessive newlines (3+ consecutive blank lines)</li>
            <li>Preserves code blocks and blockquotes (doesn't modify their content)</li>
        </ul>

        <h3>Usage</h3>
        <p>Right-click on any markdown file in the Project View or Editor and select "Fix Markdown Formatting".</p>
        <p>Keyboard shortcut: <code>Ctrl+Alt+M</code> (or <code>Cmd+Alt+M</code> on macOS)</p>

        <h3>Examples</h3>
        <p><strong>Before:</strong></p>
        <pre>
**Author:** James **Status:** Complete
- Item 1
- Item 2
Text after list


Multiple blank lines above
        </pre>

        <p><strong>After:</strong></p>
        <pre>
- **Author:** James
- **Status:** Complete

- Item 1
- Item 2

Text after list

Multiple blank lines above
        </pre>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.plugins.markdown</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Notification group for user feedback -->
        <notificationGroup id="MarkdownFixer.Notifications"
                          displayType="BALLOON"
                          isLogByDefault="true"/>
    </extensions>

    <!-- Actions -->
    <actions>
        <action id="com.markdownfixer.FixMarkdownAction"
                class="com.markdownfixer.actions.FixMarkdownAction"
                text="Fix Markdown Formatting"
                description="Fixes common markdown formatting issues (lists, metadata, newlines)"
                icon="AllIcons.Actions.Edit">

            <!-- Project View context menus (right-click on file in project tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenuModifyGroup" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenuRefactoringGroup" anchor="last"/>
            <add-to-group group-id="CutCopyPasteGroup" anchor="last"/>

            <!-- Editor tab context menu (right-click on editor tab) -->
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>

            <!-- Editor context menu (right-click in editor content) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>

            <!-- Tools menu -->
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <!-- Keyboard shortcut -->
            <keyboard-shortcut keymap="$default"
                             first-keystroke="control alt M"/>
        </action>
    </actions>
</idea-plugin>
